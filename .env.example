# Variables d'environnement sensibles — NE PAS commiter .env dans Git
# Copier ce fichier en .env et renseigner les valeurs réelles.
#
# Chargement automatique via systemd (EnvironmentFile=/chemin/vers/.env)
# ou manuellement : export $(cat .env | xargs)

TELEGRAM_TOKEN=<token_du_bot_telegram>
TELEGRAM_CHAT_ID=<id_du_groupe_de_supervision>

# Identifiants caméras RTSP
RTSP_LOGIN=<login_camera>
RTSP_PASSWORD=<mot_de_passe_camera>

# Authentification de l'interface web (HTTP Basic) — OBLIGATOIRE (CS-1144-01).
# L'application REFUSE DE DÉMARRER si ces deux variables ne sont pas définies :
# l'IHM permet de modifier les zones de sécurité, les seuils et de couper la
# détection, ces écritures doivent être protégées par mot de passe.
# Mot de passe unique par boîtier, à stocker dans le coffre-fort 4itec.
SAFECROSS_AUTH_USER=<utilisateur_supervision>
SAFECROSS_AUTH_PASSWORD=<mot_de_passe_supervision>
