# sudo cp 4isafecross.service /etc/systemd/system/
# sudo systemctl daemon-reload
# sudo systemctl enable 4isafecross.service
# sudo systemctl start 4isafecross.service

[Unit]
Description=4isafecross service
After=network.target systemd-udev-settle.service

[Service]
# for python app
#WorkingDirectory=/home/user-4itec/github/4iSafeCross/scripts
#ExecStart=/home/user-4itec/github/4iSafeCross/scripts/4isafecross.sh
# for bin app
WorkingDirectory=/home/user-4itec/4iSafeCross/
ExecStart=/home/user-4itec/4iSafeCross/app.bin
# Fichier de variables d'environnement (credentials sensibles, non versionné).
# Créer /home/user-4itec/4iSafeCross/.env depuis .env.example et le remplir :
# SAFECROSS_AUTH_USER / SAFECROSS_AUTH_PASSWORD sont OBLIGATOIRES (CS-1144-01),
# l'application refuse de démarrer sans. Pas de '-' : systemd échoue tôt et
# explicitement si le fichier est absent.
EnvironmentFile=/home/user-4itec/4iSafeCross/.env
Restart=always
RestartSec=3
# for python app
#StandardOutput=append:/home/user-4itec/github/4iSafeCross/logs/service_stdout.log
#StandardError=append:/home/user-4itec/github/4iSafeCross/logs/service_stderr.log
# for bin app
StandardOutput=append:/home/user-4itec/4iSafeCross/logs/service_stdout.log
StandardError=append:/home/user-4itec/4iSafeCross/logs/service_stderr.log

User=user-4itec
Group=user-4itec

[Install]
WantedBy=multi-user.target
