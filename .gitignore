# ── Caches d'exécution et d'outils ────────────────────────────────────────
__pycache__
.venv/
.python-version
# ruff et pytest écrivent déjà un .gitignore dans leur cache ; on l'inscrit ici
# pour ne pas dépendre de ce comportement (version d'outil, cache recréé à la main).
.ruff_cache/
.pytest_cache/
.nuitka/
uv.toml

# ── Secrets et licences : jamais versionnés ───────────────────────────────
# Les chemins config/* sont conservés pour les déploiements antérieurs au
# déplacement vers licenses/ ; public_key.pem reste suivi (clé publique).
.env
licenses/*.lic
licenses/license_state.json
licenses/license_state.key
config/4isafecross.lic
config/license_state.json
config/license_state.key

# ── État produit à l'exécution ────────────────────────────────────────────
/logs/*
!logs/
/detections
# Base SQLite créée par init_db (CS hygiène) — un commentaire de FIN de ligne
# ferait partie du motif : .gitignore ne les reconnaît pas.
db/*.db

# ── Binaires et artefacts de build ────────────────────────────────────────
# app.* : reliquats de Nuitka au temps de app.py, supprimé en v3.0.0 au profit
# de run.py + blueprints. Conservés tant que d'anciens arbres de travail peuvent
# encore en contenir.
dist/
*.dist/
*.build/
*.onefile-build/
app.build/
app.dist/
app.onefile-build/
4isafecross
4isafecross.bin
*.tar.gz
*.zip
static/ffmpeg/bin/ffmpeg.exe
static/ffmpeg/bin/ffplay.exe
static/ffmpeg/bin/ffprobe.exe

# ── Divers ────────────────────────────────────────────────────────────────
# Bac à sable de l'éditeur de zones (tools/zone_editor_sandbox.py)
tools/sandbox/
